# Porta do servidor backend
PORT=4000

# Origem permitida para CORS (URL do frontend em producao)
FRONTEND_ORIGIN=http://localhost:5173

# Segredos JWT - troque por valores aleatorios longos em producao
# (ex: gere com `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ADMIN_SECRET=troque-este-valor-para-um-segredo-longo-e-aleatorio-admin
JWT_PARTICIPANT_SECRET=troque-este-valor-para-um-segredo-longo-e-aleatorio-participante

# Credenciais do administrador criado automaticamente no primeiro start
# (recomendado trocar a senha pelo dashboard/DB depois do primeiro login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-antes-do-evento

# Caminho do arquivo do banco de dados SQLite
DB_PATH=./data/trivia.db
